# Copy this file to .env and fill in the values. .env is ignored by git. Never paste keys into a chat.
ANTHROPIC_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DESK_ALPACA_PAPER=true
DESK_AUTONOMY_LEVEL=1
DESK_REDIS_URL=redis://localhost:6379/0
DESK_DATABASE_URL=postgresql://localhost:5432/desk
DESK_PAPER_CAPITAL=100000
# autonomous cycle: 0 = pre-market, mid-session and post-close only; 60 = also every hour while the market is open
DESK_CYCLE_EVERY_MINUTES=0
DESK_POSITION_PCT=0.02
DESK_MAX_OPEN_POSITIONS=10
DESK_MAX_NEW_PER_CYCLE=3

# a buy the skeptic has a concern about needs at least this conviction (0-1)
DESK_MIN_CONVICTION_WITH_CONCERN=0.5
