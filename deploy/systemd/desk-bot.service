[Unit]
Description=Trading desk bot: agents, head trader, risk officer, execution
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
User=desk
Group=desk
WorkingDirectory=/opt/desk/app
EnvironmentFile=/opt/desk/app/.env
Environment=PYTHONUNBUFFERED=1
Environment=DESK_REQUIRE_REDIS=true
ExecStart=/opt/desk/app/.venv/bin/desk run --no-console
Restart=always
RestartSec=5
WatchdogSec=300
TimeoutStartSec=180
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/desk

[Install]
WantedBy=multi-user.target
